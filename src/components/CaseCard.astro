---
interface Props {
  title: string;
  subtitle: string;
  category: string;
  accent: 'purple' | 'red' | 'blue';
  tags?: string[];
  metric?: string;
  metricLabel?: string;
}

const { title, subtitle, category, accent, tags = [], metric, metricLabel } = Astro.props;

const accentColors = {
  purple: { glow: 'rgba(120, 100, 200, 0.18)', edge: 'rgba(120, 100, 200, 0.4)' },
  red: { glow: 'rgba(200, 80, 80, 0.15)', edge: 'rgba(200, 80, 80, 0.35)' },
  blue: { glow: 'rgba(80, 130, 200, 0.15)', edge: 'rgba(80, 130, 200, 0.35)' },
};

const c = accentColors[accent];
---

<article class="case-card" style={`--accent-glow: ${c.glow}; --accent-edge: ${c.edge};`}>
  <div class="case-card__accent" aria-hidden="true"></div>

  <header class="case-card__head">
    <span class="case-card__category mono">{category}</span>
    <span class="case-card__slug mono">{title}</span>
  </header>

  <h3 class="case-card__title">{subtitle}</h3>

  {tags.length > 0 && (
    <ul class="case-card__tags">
      {tags.map((t) => <li class="case-card__tag mono">{t}</li>)}
    </ul>
  )}

  {metric && (
    <div class="case-card__metric">
      <span class="case-card__metric-value">{metric}</span>
      {metricLabel && <span class="case-card__metric-label">{metricLabel}</span>}
    </div>
  )}

  <div class="case-card__body">
    <slot />
  </div>
</article>

<style>
  .case-card {
    position: relative;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: 28px;
    transition: border-color 0.2s ease, transform 0.2s ease;
    display: flex;
    flex-direction: column;
    gap: 18px;
    overflow: hidden;
  }

  .case-card:hover {
    border-color: var(--accent-edge);
    transform: translateY(-2px);
  }

  .case-card__accent {
    position: absolute;
    top: -80px;
    right: -80px;
    width: 280px;
    height: 280px;
    background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .case-card__head,
  .case-card__title,
  .case-card__metric,
  .case-card__body {
    position: relative;
    z-index: 1;
  }

  .case-card__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .case-card__category {
    background: var(--bg-base);
    border: 1px solid var(--accent-edge);
    color: var(--text-primary);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    padding: 5px 10px;
    border-radius: 6px;
    text-transform: uppercase;
  }

  .case-card__slug {
    color: var(--text-mono-label);
    font-size: 12px;
    letter-spacing: 0.05em;
  }

  .case-card__title {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--text-primary);
  }

  .case-card__tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .case-card__tag {
    font-size: 11px;
    color: var(--text-mono-label);
    background: var(--bg-base);
    border: 1px solid var(--border-subtle);
    padding: 4px 8px;
    border-radius: 4px;
    letter-spacing: 0.02em;
  }

  .case-card__metric {
    background: var(--bg-base);
    border-radius: 10px;
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    border: 1px solid var(--border-subtle);
  }

  .case-card__metric-value {
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--text-primary);
    font-family: 'Geist Mono', ui-monospace, 'SF Mono', Menlo, monospace;
  }

  .case-card__metric-label {
    font-size: 12px;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .case-card__body {
    color: var(--text-primary);
    font-size: 14px;
    line-height: 1.65;
  }

  .case-card__body :global(p) {
    margin-bottom: 12px;
    color: var(--text-secondary);
  }

  .case-card__body :global(p:first-child) {
    color: var(--text-primary);
  }

  .case-card__body :global(p:last-child) {
    margin-bottom: 0;
  }

  .case-card__body :global(code) {
    font-family: 'Geist Mono', ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.9em;
    background: var(--bg-base);
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--text-secondary);
  }

  @media (max-width: 720px) {
    .case-card {
      padding: 22px;
    }
    .case-card__title {
      font-size: 19px;
    }
    .case-card__metric-value {
      font-size: 24px;
    }
  }
</style>
