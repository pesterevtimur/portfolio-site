---
import { getCollection, render } from 'astro:content';
import CaseCard from './CaseCard.astro';

const cases = (await getCollection('cases')).sort(
  (a, b) => a.data.order - b.data.order
);

const renderedCases = await Promise.all(
  cases.map(async (caseDoc) => {
    const { Content } = await render(caseDoc);
    return { caseDoc, Content };
  })
);
---

<section id="cases" class="section">
  <header class="section__head">
    <div class="section__head-row">
      <span class="section__num mono">02</span>
      <p class="label">Кейсы</p>
    </div>
    <h2 class="section__title">Три проекта с реальной фактурой — где AI делает работу по жёстким правилам</h2>
  </header>
  <div class="cases__grid">
    {renderedCases.map(({ caseDoc, Content }) => (
      <CaseCard
        title={caseDoc.data.title}
        subtitle={caseDoc.data.subtitle}
        category={caseDoc.data.category}
        accent={caseDoc.data.accent}
        tags={caseDoc.data.tags}
        metric={caseDoc.data.metric}
        metricLabel={caseDoc.data.metricLabel}
      >
        <Content />
      </CaseCard>
    ))}
  </div>
</section>

<style>
  .cases__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 720px) {
    .cases__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .cases__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }
</style>
