---
const growth = [
  {
    num: '01',
    title: 'Системная проверка качества AI-ответов',
    text: 'Метрики, регрессионные тесты, контрольные наборы. Сейчас собираю первую полноценную систему проверки для одного из проектов.',
    deadline: 'Июль 2026',
  },
  {
    num: '02',
    title: 'Видимость работы AI в реальном времени',
    text: 'Логирование, трейсы, латентность, стоимость. Сейчас работаю на уровне «вижу что-то когда сломалось» — нужно «вижу что-то ДО того как сломалось».',
    deadline: 'Август 2026',
  },
  {
    num: '03',
    title: 'Гарантированный формат ответа AI',
    text: 'Валидация структуры, повторы при ошибке. Прикладной слой — есть, но жёсткая отказоустойчивость — недотянута.',
    deadline: 'Август 2026',
  },
];
---

<section id="growth" class="section">
  <header class="section__head">
    <div class="section__head-row">
      <span class="section__num mono">08</span>
      <p class="label">Куда расту</p>
    </div>
    <h2 class="section__title">Три вещи, которые активно подтягиваю до конца лета</h2>
  </header>
  <ol class="growth">
    {growth.map((g) => (
      <li class="growth__row">
        <span class="growth__num mono">{g.num}</span>
        <div class="growth__body">
          <h3 class="growth__title">{g.title}</h3>
          <p class="growth__text">{g.text}</p>
          <p class="growth__deadline mono">→ {g.deadline}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .growth {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .growth__row {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 24px;
    align-items: baseline;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .growth__row:last-child {
    border-bottom: none;
  }

  .growth__num {
    color: var(--text-mono-label);
    font-size: 36px;
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .growth__title {
    font-size: 20px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 6px;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .growth__text {
    color: var(--text-secondary);
    font-size: 16px;
    line-height: 1.55;
    margin-bottom: 8px;
  }

  .growth__deadline {
    color: var(--text-primary);
    font-size: 13px;
  }

  @media (min-width: 1000px) {
    .growth__num {
      font-size: 48px;
    }
  }

  @media (max-width: 720px) {
    .growth__row {
      grid-template-columns: 56px 1fr;
      gap: 16px;
      padding-bottom: 20px;
    }
    .growth__num {
      font-size: 28px;
    }
    .growth__title {
      font-size: 17px;
    }
    .growth__text {
      font-size: 15px;
    }
  }
</style>
