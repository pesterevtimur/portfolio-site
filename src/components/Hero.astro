---
const badges = [
  { value: '5 лет', label: 'в IT-бизнесе' },
  { value: '3 кейса', label: 'с реальной фактурой' },
  { value: 'AI-first', label: 'с 2025' },
];
---

<section class="hero" data-magnetic>
  <div class="hero__heatmap" aria-hidden="true">
    <div class="hero__blob hero__blob--main"></div>
    <div class="hero__blob hero__blob--ambient-1"></div>
    <div class="hero__blob hero__blob--ambient-2"></div>
    <div class="hero__blob hero__blob--ambient-3"></div>
    <div class="hero__blob hero__blob--ambient-4"></div>
    <div class="hero__blob hero__blob--ambient-5"></div>
  </div>
  <div class="hero__inner">
    <p class="label hero__label">→ AI-архитектура · B2B</p>
    <h1 class="hero__headline">
      Запускаю AI-процессы,<br />
      которые не разваливаются<br />
      на втором месяце.
    </h1>
    <p class="hero__sub">
      Жёсткие ТЗ перед стартом. Один AI пишет — другой проверяет.
      Видимая работа агентов вместо чёрного ящика.
    </p>
    <p class="hero__tagline">
      От ТЗ до запуска — не пишу код руками. Задаю рамки, в которых пишет AI.
    </p>
    <div class="hero__cta">
      <a class="cta cta--primary" href="https://t.me/timursky">Написать в Telegram</a>
      <a class="cta cta--secondary" href="#cases">Кейсы ↓</a>
    </div>
    <div class="hero__badges">
      {badges.map((b) => (
        <div class="badge">
          <span class="badge__value">{b.value}</span>
          <span class="badge__label mono">{b.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    margin: 0 calc(50% - 50vw);
  }

  .hero__heatmap {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero__blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    will-change: transform;
  }

  .hero__blob--main {
    width: 600px;
    height: 600px;
    left: calc(var(--mx, 100) * 1% - 300px);
    top: calc(var(--my, 0) * 1% - 300px);
    background: radial-gradient(circle, rgba(140, 100, 240, 0.35) 0%, transparent 70%);
  }

  .hero__blob--ambient-1,
  .hero__blob--ambient-2,
  .hero__blob--ambient-3,
  .hero__blob--ambient-4,
  .hero__blob--ambient-5 {
    transform: translate(-50%, -50%);
  }

  .hero__blob--ambient-1 {
    width: 500px;
    height: 500px;
    left: 10%;
    top: 15%;
    background: radial-gradient(circle, rgba(80, 120, 220, 0.28) 0%, transparent 70%);
    animation: hero-drift-1 22s ease-in-out infinite;
  }

  .hero__blob--ambient-2 {
    width: 400px;
    height: 400px;
    left: 85%;
    top: 20%;
    background: radial-gradient(circle, rgba(60, 140, 200, 0.25) 0%, transparent 70%);
    animation: hero-drift-2 18s ease-in-out infinite;
    animation-delay: 4s;
  }

  .hero__blob--ambient-3 {
    width: 550px;
    height: 550px;
    left: 20%;
    top: 85%;
    background: radial-gradient(circle, rgba(120, 80, 200, 0.22) 0%, transparent 70%);
    animation: hero-drift-3 25s ease-in-out infinite;
    animation-delay: 8s;
  }

  .hero__blob--ambient-4 {
    width: 380px;
    height: 380px;
    left: 90%;
    top: 55%;
    background: radial-gradient(circle, rgba(70, 100, 180, 0.20) 0%, transparent 70%);
    animation: hero-drift-4 20s ease-in-out infinite;
    animation-delay: 2s;
  }

  .hero__blob--ambient-5 {
    width: 700px;
    height: 700px;
    left: 50%;
    top: 95%;
    background: radial-gradient(circle, rgba(150, 90, 230, 0.18) 0%, transparent 70%);
    animation: hero-drift-5 30s ease-in-out infinite;
    animation-delay: 6s;
  }

  @keyframes hero-drift-1 {
    0%, 100% { transform: translate(-50%, -50%) scale(1); }
    50%      { transform: translate(-30%, -40%) scale(1.15); }
  }
  @keyframes hero-drift-2 {
    0%, 100% { transform: translate(-50%, -50%) scale(1); }
    50%      { transform: translate(-70%, -30%) scale(0.9); }
  }
  @keyframes hero-drift-3 {
    0%, 100% { transform: translate(-50%, -50%) scale(1); }
    50%      { transform: translate(-40%, -65%) scale(1.1); }
  }
  @keyframes hero-drift-4 {
    0%, 100% { transform: translate(-50%, -50%) scale(1); }
    50%      { transform: translate(-60%, -40%) scale(0.95); }
  }
  @keyframes hero-drift-5 {
    0%, 100% { transform: translate(-50%, -50%) scale(1); }
    50%      { transform: translate(-45%, -55%) scale(1.05); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__blob {
      animation: none;
    }
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 32px 32px;
    z-index: 1;
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    max-width: 1080px;
    margin: 0 auto;
    padding: 120px 24px 80px;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero__label {
    margin-bottom: 32px;
  }

  .hero__headline {
    font-size: 56px;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin-bottom: 24px;
    color: var(--text-primary);
  }

  .hero__sub {
    font-size: 18px;
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 600px;
    margin-bottom: 24px;
  }

  .hero__tagline {
    font-family: 'Geist Mono', ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--text-primary);
    max-width: 600px;
    padding-left: 16px;
    border-left: 2px solid var(--text-primary);
    margin-bottom: 36px;
    line-height: 1.5;
  }

  .hero__cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 64px;
  }

  .cta {
    display: inline-block;
    padding: 14px 22px;
    border-radius: 8px;
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
    transition: all 0.15s ease;
    line-height: 1;
  }

  .cta--primary {
    background: var(--cta-bg);
    color: var(--cta-text);
    border: 1px solid var(--cta-bg);
  }

  .cta--primary:hover {
    transform: translateY(-1px);
    filter: brightness(0.95);
  }

  .cta--secondary {
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
    background: transparent;
  }

  .cta--secondary:hover {
    background: var(--border-subtle);
  }

  .hero__badges {
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 12px;
    justify-content: start;
  }

  .badge {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 120px;
  }

  .badge__value {
    font-size: 22px;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.015em;
    line-height: 1.1;
  }

  .badge__label {
    color: var(--text-mono-label);
    font-size: 11px;
    letter-spacing: 0.05em;
  }

  @media (max-width: 720px) {
    .hero__blob {
      filter: blur(50px);
    }

    .hero__blob--ambient-3,
    .hero__blob--ambient-4 {
      display: none;
    }

    .hero__inner {
      padding: 96px 16px 48px;
    }

    .hero__headline {
      font-size: 36px;
    }

    .hero__sub {
      font-size: 16px;
    }

    .cta {
      padding: 12px 18px;
      font-size: 14px;
    }

    .hero__badges {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .badge {
      padding: 14px 16px;
      min-width: 0;
    }

    .badge__value {
      font-size: 18px;
    }
  }
</style>
