---
const stack = [
  {
    group: 'AI-модели и API',
    items: [
      { name: 'Claude (Anthropic)', note: 'основная рабочая модель' },
      { name: 'GPT (OpenAI)', note: 'для второго мнения и сравнения' },
      { name: 'Codex CLI', note: 'отдельный пайплайн проверки' },
    ],
  },
  {
    group: 'Среды разработки агентов',
    items: [
      { name: 'Claude Code', note: 'CLI + VS Code' },
      { name: 'Claude Desktop', note: 'архитектурные решения' },
      { name: 'Skills + MCP servers', note: 'контракты работы агентов' },
    ],
  },
  {
    group: 'Код, данные, форматы',
    items: [
      { name: 'Python', note: 'детерминированные пайплайны и интеграции' },
      { name: 'SQLite / Postgres', note: 'где нужна персистентность' },
      { name: 'Markdown в git', note: 'wiki, спецификации, ADR' },
      { name: 'JSON', note: 'структурированные ответы AI, обмен данных между агентами' },
      { name: 'LLM Wiki паттерн', note: 'компаундирующая база знаний для каждого проекта' },
    ],
  },
  {
    group: 'Инфраструктура',
    items: [
      { name: 'GitHub', note: 'версионирование артефактов' },
      { name: 'Telegram Bot API', note: 'для сборщиков и нотификаций' },
      { name: 'PowerShell / Bash', note: 'автоматизация локальных пайплайнов' },
    ],
  },
  {
    group: 'Изучаю сейчас',
    items: [
      { name: 'Pressure-testing skills', note: 'через skill-creator' },
      { name: 'Eval-framework Anthropic', note: 'для системной проверки качества' },
    ],
  },
];
---

<section id="stack" class="section">
  <header class="section__head">
    <div class="section__head-row">
      <span class="section__num mono">05</span>
      <p class="label">Стек</p>
    </div>
    <h2 class="section__title">Чем работаю</h2>
  </header>
  <div class="stack">
    {stack.map((group, i) => (
      <div class="stack__group">
        <h3 class="stack__group-title">
          <span class="stack__group-num mono">0{i + 1}</span>
          {group.group}
        </h3>
        <ul class="stack__items">
          {group.items.map((item) => (
            <li class="stack__item">
              <span class="stack__item-name">{item.name}</span>
              <span class="stack__item-note"> — {item.note}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .stack {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
  }

  @media (min-width: 720px) {
    .stack {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px 48px;
    }
  }

  @media (min-width: 1000px) {
    .stack {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .stack__group {
    padding-top: 16px;
    border-top: 1px solid var(--border-subtle);
  }

  .stack__group-title {
    font-family: 'Geist Mono', ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mono-label);
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .stack__group-num {
    color: var(--text-primary);
    background: var(--bg-elevated);
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 11px;
    letter-spacing: 0.05em;
  }

  .stack__items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .stack__item {
    font-size: 15px;
    line-height: 1.5;
  }

  .stack__item-name {
    color: var(--text-primary);
    font-weight: 500;
  }

  .stack__item-note {
    color: var(--text-secondary);
  }
</style>
